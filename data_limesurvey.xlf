=LET(

  answers,        'Perception de la qualité de vie'!A1:FN167,
  answersHeader,  SUBSTITUTE(TAKE(answers, 1), "[", CHAR(10) & "["),
  answersData,    DROP(answers, 1),

  isNotBlank,
    LAMBDA(values, IF(ISBLANK(values), FALSE, TRUE)),

  selectQuestion,
    LAMBDA(header,data,question,
      LET(
        hdr, TOCOL(header,,1),
        mask, --(LEFT(LOWER(hdr), LEN(question)) = LOWER(question)),
        cols, FILTER(SEQUENCE(ROWS(hdr)), mask = 1),
        VSTACK(
          CHOOSECOLS(MID(header,SEARCH("[",header)+1,SEARCH("]",header)-SEARCH("[",header)-1), TRANSPOSE(cols)),
          CHOOSECOLS(data, TRANSPOSE(cols))
        )
      )
    ),

  selectColumns,
    LAMBDA(range,cols,
      CHOOSECOLS(range, COLUMN(cols))
    ),

  collapseAnswers,
    LAMBDA(headers,rowValues,
      LET(
        mask,  (rowValues<>"Non") * (rowValues<>""),
        filteredHeaders, FILTER(headers, mask),
        labels,
          MAP(SEQUENCE(COLUMNS(filteredHeaders)),
            LAMBDA(i,
              LET(h,   INDEX(filteredHeaders, i),
                val, INDEX(FILTER(rowValues, mask), i),
                start, FIND("[", h)+1,
                end,   FIND("]", h),
                label, MID(h, start, end-start),

                IF(LOWER(label)="autre",
                  val,
                  label
                )
              )
            )
          ),
        IFERROR(TEXTJOIN(", ", TRUE, labels),"")
      )
    ),

  stackCollapsedAnswers,
    LAMBDA(header,data,startCol,nbrCols,
      BYROW(
        CHOOSECOLS(data, SEQUENCE(nbrCols,1,startCol)),
        LAMBDA(r,
          collapseAnswers(CHOOSECOLS(header, SEQUENCE(nbrCols,1,startCol)), r)
        )
      )
    ),

  textBetweenBrackets,
    LAMBDA(text, MID(text, SEARCH("[", text)+1, SEARCH("]", text)-SEARCH("[", text)-1)),  

  OuiToOne,
    LAMBDA(value, IF(LOWER(value)="oui", 1, 0)),
  
  NonEmptyToOne,
    LAMBDA(value, IF(ISBLANK(value), 0, 1)),

  position,
    SWITCH(CHOOSECOLS(answersData, 25),
      "Ergothérapeute praticien(ne)", "Ergo Practicien",
      "Chef de service ergothérapie (ergothérapeute de formation)", "Chef Ergo",
      "Chef de service ergothérapie (sans être ergothérapeute de formation)", "Chef " & CHOOSECOLS(answersData, 26),
      ""
    ),

  educationN1,
    IF(CHOOSECOLS(answersData, 27) = "Non", CHOOSECOLS(answersData, 28), "Ergo"),

  emploi,
    IF(CHOOSECOLS(answersData, 113) = "J'ai plusieurs emplois",
       CHOOSECOLS(answersData, 118) & " / " &CHOOSECOLS(answersData, 118),
       CHOOSECOLS(answersData, 113)
    ),

  contract,
    IF(CHOOSECOLS(answersData, 115) = "Autre", CHOOSECOLS(answersData, 116), CHOOSECOLS(answersData, 115)),

  schedule,
    IF(CHOOSECOLS(answersData, 117) = "Autre", CHOOSECOLS(answersData, 118), CHOOSECOLS(answersData, 117)),

  header,
    HSTACK(
      {"Complet","Position","Profession N+1","Secteur","Contexte","Indiv. ou équipe","Localisation","Milieu Hospit","Public Privé"},
      CHOOSECOLS(answersHeader, SEQUENCE(2,1,113)),
      {"Emploi","Contrat","Horaire"},
      CHOOSECOLS(answersHeader, SEQUENCE(3,1,119)),
      {"Genre","Satisfaction","Commentaires"},
      CHOOSECOLS(answersHeader, SEQUENCE(73,1,29)),
      textBetweenBrackets(CHOOSECOLS(answersHeader, SEQUENCE(9,1,10))),{"Autre secteur"},
      textBetweenBrackets(CHOOSECOLS(answersHeader, SEQUENCE(6,1,103))),{"Autre lieu de travail"}
    ),

  output,
    VSTACK(
      header,
      HSTACK(
        isNotBlank(CHOOSECOLS(answersData,2)),
        position,
        educationN1,
        stackCollapsedAnswers(answersHeader, answersData, 10, 10),
        stackCollapsedAnswers(answersHeader, answersData, 20, 4),
        CHOOSECOLS(answersData, 24),
        stackCollapsedAnswers(answersHeader, answersData, 103, 7),
        CHOOSECOLS(answersData, 110),
        stackCollapsedAnswers(answersHeader, answersData, 111, 2),
        CHOOSECOLS(answersData, SEQUENCE(2,1,113)),
        emploi,
        contract,
        schedule,
        CHOOSECOLS(answersData, SEQUENCE(6,1,119)),
        CHOOSECOLS(answersData, SEQUENCE(73,1,29)),
        OuiToOne(CHOOSECOLS(answersData, SEQUENCE(9,1,10))),
        NonEmptyToOne(CHOOSECOLS(answersData, 19)),
        OuiToOne(CHOOSECOLS(answersData, SEQUENCE(6,1,103))),
        NonEmptyToOne(CHOOSECOLS(answersData, 109))
      )
    ),

  output

)