diff --git a/src/features/card-filters/CardFilters.tsx b/src/features/card-filters/CardFilters.tsx
new file mode 100644
index 0000000..9e274c9
--- /dev/null
+++ b/src/features/card-filters/CardFilters.tsx
@@ -0,0 +1,86 @@
+import { COLORS, RARITIES, SORT_DIRS, SORT_KEYS, filterParsers } from "./filterParams.ts";
+import type { UseQueryStatesReturn, inferParserType } from "nuqs";
+import "./CardFilters.css";
+
+type Filters = inferParserType<typeof filterParsers>;
+
+type Props = {
+  filters: Filters;
+  setFilters: UseQueryStatesReturn<typeof filterParsers>[1];
+  onReset: () => void;
+  shown: number;
+  total: number;
+};
+
+// Add the value if missing, remove it if present.
+const toggle = <T extends string>(list: readonly T[], value: T): T[] =>
+  list.includes(value) ? list.filter((v) => v !== value) : [...list, value];
+
+export default function CardFilters({ filters, setFilters, onReset, shown, total }: Props) {
+  return (
+    <section className="card-filters" aria-label="Card filters">
+      <div className="card-filters__group" role="group" aria-label="Colors">
+        {COLORS.map((c) => (
+          <button
+            key={c}
+            type="button"
+            aria-pressed={filters.colors.includes(c)}
+            onClick={() => setFilters({ colors: toggle(filters.colors, c) })}
+          >
+            {c}
+          </button>
+        ))}
+      </div>
+
+      <div className="card-filters__group" role="group" aria-label="Rarity">
+        {RARITIES.map((r) => (
+          <button
+            key={r}
+            type="button"
+            aria-pressed={filters.rarity.includes(r)}
+            onClick={() => setFilters({ rarity: toggle(filters.rarity, r) })}
+          >
+            {r}
+          </button>
+        ))}
+      </div>
+
+      <input
+        type="search"
+        placeholder="Type (e.g. creature)"
+        aria-label="Filter by card type"
+        value={filters.type}
+        onChange={(e) => setFilters({ type: e.target.value })}
+      />
+
+      <div className="card-filters__group">
+        <select
+          aria-label="Sort by"
+          value={filters.sort ?? ""}
+          onChange={(e) => setFilters({ sort: SORT_KEYS.find((k) => k === e.target.value) ?? null })}
+        >
+          <option value="">Sort: default</option>
+          {SORT_KEYS.map((k) => (
+            <option key={k} value={k}>
+              {k}
+            </option>
+          ))}
+        </select>
+        <button
+          type="button"
+          disabled={!filters.sort}
+          onClick={() => setFilters({ dir: filters.dir === SORT_DIRS[0] ? "desc" : "asc" })}
+        >
+          {filters.dir === "asc" ? "↑" : "↓"}
+        </button>
+      </div>
+
+      <p className="card-filters__count">
+        {shown} of {total} cards
+        <button type="button" onClick={onReset}>
+          Clear
+        </button>
+      </p>
+    </section>
+  );
+}
diff --git a/src/features/card-filters/columns.ts b/src/features/card-filters/columns.ts
new file mode 100644
index 0000000..30872c9
--- /dev/null
+++ b/src/features/card-filters/columns.ts
@@ -0,0 +1,56 @@
+import {
+  columnFilteringFeature,
+  createColumnHelper,
+  createFilteredRowModel,
+  createSortedRowModel,
+  rowSortingFeature,
+  tableFeatures,
+} from "@tanstack/react-table";
+import type { CardColor, ScryfallCard } from "./types.ts";
+
+// Features are opt-in in v9: register only what the table uses.
+// Keep this at module level so its reference never changes.
+export const features = tableFeatures({
+  columnFilteringFeature,
+  filteredRowModel: createFilteredRowModel(),
+  rowSortingFeature,
+  sortedRowModel: createSortedRowModel(),
+});
+
+const RARITY_RANK: Record<string, number> = { common: 0, uncommon: 1, rare: 2, mythic: 3 };
+
+// Double-faced cards keep their colors on the faces, so fall back to the front face.
+const getColors = (card: ScryfallCard): CardColor[] =>
+  card.colors ?? card.card_faces?.[0]?.colors ?? [];
+
+const getTypeLine = (card: ScryfallCard): string =>
+  card.type_line ?? card.card_faces?.[0]?.type_line ?? "";
+
+const helper = createColumnHelper<typeof features, ScryfallCard>();
+
+// A column = how to read a value from a card + how it filters/sorts.
+// filterFn(row, columnId, filterValue) returns true to KEEP the row.
+export const columns = helper.columns([
+  helper.accessor((card) => card.name, { id: "name" }),
+  helper.accessor((card) => getColors(card), {
+    id: "colors",
+    filterFn: (row, columnId, selected: string[]) => {
+      const colors = row.getValue<CardColor[]>(columnId);
+      return selected.some((c) => (c === "C" ? colors.length === 0 : colors.includes(c as CardColor)));
+    },
+  }),
+  helper.accessor((card) => getTypeLine(card), {
+    id: "type",
+    filterFn: (row, columnId, text: string) =>
+      row.getValue<string>(columnId).toLowerCase().includes(text.toLowerCase()),
+  }),
+  helper.accessor((card) => card.cmc ?? 0, { id: "cmc" }),
+  helper.accessor((card) => RARITY_RANK[card.rarity] ?? -1, {
+    id: "rarity",
+    filterFn: (row, _columnId, selected: string[]) => selected.includes(row.original.rarity),
+  }),
+  helper.accessor((card) => (card.prices?.eur ? Number(card.prices.eur) : undefined), {
+    id: "price",
+    sortUndefined: "last", // cards without a price always go to the end
+  }),
+]);
diff --git a/src/features/card-filters/filterParams.ts b/src/features/card-filters/filterParams.ts
new file mode 100644
index 0000000..f97a73b
--- /dev/null
+++ b/src/features/card-filters/filterParams.ts
@@ -0,0 +1,24 @@
+import {
+  debounce,
+  parseAsArrayOf,
+  parseAsString,
+  parseAsStringLiteral,
+} from "nuqs";
+
+// "as const" keeps the exact strings, so TypeScript knows the allowed values.
+export const COLORS = ["W", "U", "B", "R", "G", "C"] as const; // C = colorless
+export const RARITIES = ["common", "uncommon", "rare", "mythic"] as const;
+export const SORT_KEYS = ["name", "cmc", "rarity", "price"] as const;
+export const SORT_DIRS = ["asc", "desc"] as const;
+
+// One parser per URL key. nuqs uses it to read AND write the key.
+// Default values are never written to the URL (clean links).
+export const filterParsers = {
+  colors: parseAsArrayOf(parseAsStringLiteral(COLORS)).withDefault([]), // ?colors=W,U
+  rarity: parseAsArrayOf(parseAsStringLiteral(RARITIES)).withDefault([]), // ?rarity=rare
+  type: parseAsString
+    .withDefault("") // ?type=creature
+    .withOptions({ limitUrlUpdates: debounce(300) }), // state is instant, URL waits 300 ms
+  sort: parseAsStringLiteral(SORT_KEYS), // no default: null = Scryfall's order
+  dir: parseAsStringLiteral(SORT_DIRS).withDefault("asc"),
+};
