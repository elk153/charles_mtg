sequenceDiagram
    participant Browser
    participant main as main.jsx
    participant ReactDOM
    participant AppProviders
    participant PersistProv as PersistenceProvider
    participant QueryProv as QueryDevToolsProvider
    participant RouterProv as RouterProvider
    participant Router
    participant App as App.jsx
    participant QueryClient as React Query
    participant API as Scryfall API
    participant DOM as DOM/UI

    Browser->>main: Execute main.jsx
    main->>main: Import dependencies
    main->>main: Get root element
    main->>ReactDOM: createRoot(root)
    ReactDOM->>ReactDOM: Create root instance
    main->>ReactDOM: render(StrictMode > AppProviders)
    
    ReactDOM->>AppProviders: Render AppProviders
    AppProviders->>AppProviders: Import providers & router config
    
    AppProviders->>PersistProv: Render PersistenceProvider
    PersistProv->>PersistProv: Load persisted state from storage
    PersistProv->>PersistProv: Initialize queryClient
    
    AppProviders->>QueryProv: Render QueryDevToolsProvider
    QueryProv->>QueryProv: Setup React Query DevTools
    
    AppProviders->>RouterProv: Render RouterProvider
    RouterProv->>Router: Initialize Router
    Router->>Router: Detect initial route (/)
    Router->>Router: Match route config
    Router->>Router: Redirect to /random (index route)
    
    Router->>App: Mount App.jsx component
    App->>App: useState(theme='dark')
    App->>App: useState(selectedCardId=null)
    App->>App: useState(randomSeed=Date.now())
    App->>App: useLocation() get /random
    App->>App: useParams() extract params
    App->>App: Evaluate route logic
    App->>App: isRandomRoute=true
    App->>App: routeParam='cards/random'
    
    App->>App: Call useScryfallCardsSearch hook
    App->>QueryClient: Check cache for cards/random
    QueryClient->>QueryClient: Cache miss (first load)
    QueryClient->>API: GET /cards/random?format=json
    API-->>QueryClient: Return random card data
    QueryClient->>QueryClient: Store in cache (staleTime: 24h)
    QueryClient-->>App: Return {data, isLoading}
    
    App->>App: Call usePreFetchUrl hook
    App->>QueryClient: Prefetch cardSymbols
    QueryClient->>API: GET /api/symbology
    API-->>QueryClient: Return symbols
    QueryClient->>QueryClient: Store in cache
    
    App->>App: useMemo calculate activeCard
    App->>App: useMemo calculate overlayCard
    
    App->>App: useEffect #1 - Set theme
    App->>DOM: setAttribute data-theme=dark
    
    App->>App: useEffect #2 - Splash animation
    App->>DOM: Get splash elements
    App->>DOM: Add 'ready' class
    App->>DOM: Listen for transitionend
    
    App->>App: useEffect #3 - Route cleanup
    
    App->>App: Compute JSX tree
    App->>DOM: Render FloatingNavBar
    App->>DOM: Render Outlet (CardsList)
    
    QueryClient->>App: Update with fetched card data
    App->>App: Re-render with card data
    App->>DOM: Update CardsList with cards
    
    DOM->>DOM: Trigger splash transitionend
    App->>DOM: Add 'visible' class to root
    App->>DOM: Add 'background' class to splash
    
    App->>DOM: Browser paint initial render
    DOM-->>Browser: Show loaded app
    
    Note over App: Initial render complete
    Note over App: App ready for user interaction