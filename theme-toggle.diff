index 0000000..59215bc
--- /dev/null
+++ b/src/components/FloatingNavBar/FloatingThemeToggle.css
@@ -0,0 +1,35 @@
+/* Theme toggle button inside the FloatingNavBar.
+   Colors come from the theme tokens, so the icon stays readable on both
+   the light frosted bar and the dark one. */
+
+.floating-theme-toggle {
+  flex: none;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  width: 36px;
+  height: 36px;
+  padding: 0;
+  border: none;
+  border-radius: 50%;
+  background: transparent;
+  cursor: pointer;
+  font-size: 22px; /* the icons are sized in em */
+  color: var(--text-secondary);
+  transition: background 0.15s, color 0.15s, transform 0.2s;
+}
+
+.floating-theme-toggle:hover,
+.floating-theme-toggle:focus-visible {
+  color: var(--text-accent);
+  background: color-mix(in srgb, var(--text-accent) 12%, transparent);
+}
+
+.floating-theme-toggle:focus-visible {
+  outline: 2px solid var(--text-accent);
+  outline-offset: 2px;
+}
+
+.floating-theme-toggle:active {
+  transform: scale(0.92);
+}
diff --git a/src/components/FloatingNavBar/FloatingThemeToggle.tsx b/src/components/FloatingNavBar/FloatingThemeToggle.tsx
new file mode 100644
index 0000000..0f0778a
--- /dev/null
+++ b/src/components/FloatingNavBar/FloatingThemeToggle.tsx
@@ -0,0 +1,33 @@
+import { useTheme } from "../../app/AppProviders/ThemeContext.ts";
+import IconMoon from "../../assets/IconMoon.tsx";
+import IconSun from "../../assets/IconSun.tsx";
+import "./FloatingThemeToggle.css";
+
+/**
+ * Switches the whole app between the dark and light theme.
+ *
+ * `useTheme` is a custom hook that reads the theme state shared by
+ * ThemeProvider through React context. Changing it there updates
+ * <html data-theme="...">, which theme.css turns into new colors.
+ *
+ * The icon shows the theme you will GET when you click, and the
+ * aria-label says the same in words for screen readers.
+ */
+export default function FloatingThemeToggle() {
+  const { theme, setTheme } = useTheme();
+
+  const nextTheme = theme === "dark" ? "light" : "dark";
+  const label = `Switch to ${nextTheme} theme`;
+
+  return (
+    <button
+      type="button"
+      className="floating-theme-toggle"
+      onClick={() => setTheme(nextTheme)}
+      aria-label={label}
+      title={label}
+    >
+      {nextTheme === "light" ? <IconSun /> : <IconMoon />}
+    </button>
+  );
+}
