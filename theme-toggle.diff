--- /dev/null
+++ b/src/features/navigation/NavThemeToggle.css
@@ -0,0 +1,52 @@
+/* ==========================================================================
+   NavThemeToggle.css
+   Round button for the NavBar (desktop and mobile). It reuses the pill look
+   of .nav-search and the icon glow of .nav-item.is-active, all through the
+   theme.css tokens, so it follows the dark and light theme by itself.
+   ========================================================================== */
+
+.nav-theme-toggle {
+  /* .nav-icon reads its size from --icon-size, normally set by .nav-item */
+  --icon-size: 1.2rem;
+
+  appearance: none;
+  flex: none;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  width: 2.1rem;
+  height: 2.1rem;
+  padding: 0;
+  cursor: pointer;
+  color: var(--text-secondary);
+  background: color-mix(in srgb, var(--sublayer-bg, #000) 55%, transparent);
+  border: 1px solid color-mix(in srgb, var(--btn-gold) 30%, transparent);
+  border-radius: 999px;
+  transition: border-color 0.4s ease, box-shadow 0.4s ease;
+}
+
+.nav-theme-toggle:hover,
+.nav-theme-toggle:focus-visible {
+  border-color: var(--text-accent);
+  box-shadow: 0 0 0 1px color-mix(in srgb, var(--text-accent) 40%, transparent),
+    0 0 14px color-mix(in srgb, var(--text-accent) 30%, transparent);
+}
+
+.nav-theme-toggle:focus-visible {
+  outline: 2px solid var(--text-accent);
+  outline-offset: 2px;
+}
+
+/* Same "lit up" look as a selected nav item, shown on hover and focus. */
+.nav-theme-toggle:hover .nc-trace,
+.nav-theme-toggle:focus-visible .nc-trace {
+  stroke: var(--text-accent);
+  opacity: 1;
+}
+
+.nav-theme-toggle:hover .nc-core,
+.nav-theme-toggle:focus-visible .nc-core {
+  fill: var(--text-accent);
+  opacity: 1;
+  filter: drop-shadow(0 0 4px var(--text-accent));
+}
